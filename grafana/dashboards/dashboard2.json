    {
      "id": 7,
      "title": "Estado do Circuit Breaker (0=Closed, 1=Open, 2=Half-Open)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "max(circuit_breaker_state)",
          "refId": "A",
          "legendFormat": "Circuit Breaker State"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 2,
          "decimals": 0,
          "custom": {
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "always",
            "pointSize": 5
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Closed (0)",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "Open (1)",
                  "color": "red",
                  "index": 1
                },
                "2": {
                  "text": "Half-Open (2)",
                  "color": "yellow",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              },
              {
                "color": "yellow",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
